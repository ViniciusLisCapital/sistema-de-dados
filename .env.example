# Modelo de variáveis de ambiente. Copie para `.env` e preencha com os valores reais.
#   cp .env.example .env
# O `.env` NUNCA é versionado (contém credenciais). Peça os valores ao time.

# --- Banco MySQL (macro_brasil) ---
# Servidor na rede local da empresa (ex.: 192.168.15.200)
MYSQL_HOST=
MYSQL_USER=
MYSQL_PASSWORD=

# --- API FRED (Federal Reserve) ---
# Gere uma chave em https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# --- API BLS (Bureau of Labor Statistics) ---
# OPCIONAL. Sem chave a API responde, mas com limites menores (25 series /
# 10 anos / 25 requisicoes por dia, sem catalog nem calculations).
# Registro gratuito e imediato em https://data.bls.gov/registrationEngine/
BLS_API_KEY=

# --- API BEA (Bureau of Economic Analysis) ---
# OBRIGATORIA para o caminho de API do `connectors/bea.py` (o caminho de xlsx nao
# usa chave nenhuma). Registro gratuito e imediato em
# https://apps.bea.gov/API/signup/ (nome + email + aceite de termos).
# Limites: 100 requisicoes/min, 100 MB/min, 30 erros/min.
BEA_API_KEY=
