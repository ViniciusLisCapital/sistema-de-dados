      "seed": 1493299624,
      "version": 107,
      "versionNonce": 478569432,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782859412108,
      "link": null,
      "locked": false,
      "text": "THE SURPRISE\nin: what the Fed really did + the final guess\nout: surprise = real - expected, direction (hawk/dove),\nsize 0-1, and a short story",
      "fontSize": 13,
      "fontFamily": 6,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "lCxDN65-g_7OS2WamP7J0",
      "originalText": "THE SURPRISE\nin: what the Fed really did + the final guess\nout: surprise = real - expected, direction (hawk/dove),\nsize 0-1, and a short story",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "iAZnfun4PwbY_KTIfF9Jv",
      "type": "text",
      "x": -2620.666666666667,
      "y": -1479.8333333333328,
      "width": 324.32354736328125,
      "height": 16.25,
      "angle": 0,
      "strokeColor": "#757575",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bB5",
      "roundness": null,
      "seed": 1243970728,
      "version": 94,
      "versionNonce": 2044174760,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782859412142,
      "link": null,
      "locked": false,
      "text": "(uses Guess #4, or Guess #5 when the news step is on)",
      "fontSize": 13,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "(uses Guess #4, or Guess #5 when the news step is on)",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
