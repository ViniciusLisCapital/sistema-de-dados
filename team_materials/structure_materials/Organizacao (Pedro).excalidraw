    },
    {
      "id": "1sGa5BgJlsrCFQZMUHV1S",
      "type": "text",
      "x": -4098.666666666667,
      "y": -960.8333333333328,
      "width": 245.89459228515625,
      "height": 97.5,
      "angle": 0,
      "strokeColor": "#3c3c3c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b8O",
      "roundness": null,
      "seed": 1310388136,
      "version": 93,
      "versionNonce": 1699275176,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782859412138,
      "link": null,
      "locked": false,
      "text": "- Mirrors a real trading firm: each agent\n  a specialist role.\n- Hybrid comms: structured reports by\n  default; natural language only to debate.\n- Goal: avoid the telephone effect, where\n  context decays over long chat chains.",
      "fontSize": 13,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Mirrors a real trading firm: each agent\n  a specialist role.\n- Hybrid comms: structured reports by\n  default; natural language only to debate.\n- Goal: avoid the telephone effect, where\n  context decays over long chat chains.",
      "autoResize": true,
      "lineHeight": 1.25,
