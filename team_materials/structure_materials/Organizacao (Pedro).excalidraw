    {
      "id": "V-yjokJbVS47Fi3JRyarf",
      "type": "text",
      "x": -3348.666666666667,
      "y": -584.8333333333328,
      "width": 467.5574951171875,
      "height": 157.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9t",
      "roundness": null,
      "seed": 1618570920,
      "version": 98,
      "versionNonce": 1595708328,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782859412141,
      "link": null,
      "locked": false,
      "text": "- No rule for who talks how much, so a chatty member can hog the\n  room and over-shape the result (a known AI-debate problem). [us]\n- The thin people were never checked against real behavior. [us]\n- The debate is described as 3 fixed rounds, set by hand. [us]\n- How a spoken argument becomes a new number is never explained. [us]\n- The paper promises 'strategic information disclosure' but the\n  mechanics never actually show it. [us]\n- No 'what the market already expects' and no rate path. The dollar\n  trades on both, so this is the big hole for us. [us]",
      "fontSize": 14,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- No rule for who talks how much, so a chatty member can hog the\n  room and over-shape the result (a known AI-debate problem). [us]\n- The thin people were never checked against real behavior. [us]\n- The debate is described as 3 fixed rounds, set by hand. [us]\n- How a spoken argument becomes a new number is never explained. [us]\n- The paper promises 'strategic information disclosure' but the\n  mechanics never actually show it. [us]\n- No 'what the market already expects' and no rate path. The dollar\n  trades on both, so this is the big hole for us. [us]",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
