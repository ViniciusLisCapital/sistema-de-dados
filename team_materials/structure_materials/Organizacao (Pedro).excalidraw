      "isDeleted": false,
      "boundElements": [],
      "updated": 1782859412142,
      "link": null,
      "locked": false,
      "text": "Why they chose it",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why they chose it",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "px7cUC3y4lVQgQeQaBV_R",
      "type": "text",
      "x": -2808.666666666667,
      "y": -804.8333333333328,
      "width": 509.2484130859375,
      "height": 130,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bBg",
      "roundness": null,
      "seed": 77198248,
      "version": 252,
      "versionNonce": 808067240,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782859412142,
      "link": null,
      "locked": false,
      "text": "- Markets and the dollar move on the SURPRISE versus what was expected, not on the\n  bare rate, so they built a tool that measures that surprise directly. [F]\n- The Fed publishes its thinking in words on a fixed schedule, so they read the words\n  in order and keep a running forecast, instead of simulating any people. [F]\n- They keep only the last guess plus each new document (a 'filtration'), so each step\n  stays simple and there is never one giant prompt. [F]\n- They wanted a measure that still works at near-zero rates, where market-based\n  surprise measures go flat. [F]",
      "fontSize": 13,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Markets and the dollar move on the SURPRISE versus what was expected, not on the\n  bare rate, so they built a tool that measures that surprise directly. [F]\n- The Fed publishes its thinking in words on a fixed schedule, so they read the words\n  in order and keep a running forecast, instead of simulating any people. [F]\n- They keep only the last guess plus each new document (a 'filtration'), so each step\n  stays simple and there is never one giant prompt. [F]\n- They wanted a measure that still works at near-zero rates, where market-based\n  surprise measures go flat. [F]",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
