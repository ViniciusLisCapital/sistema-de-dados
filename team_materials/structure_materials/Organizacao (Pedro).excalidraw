    {
      "id": "3DOlTpz9Tr6vBMYfSwDu1",
      "type": "text",
      "x": -2805.666666666667,
      "y": -1448.8333333333328,
      "width": 618.0452880859375,
      "height": 32.5,
      "angle": 0,
      "strokeColor": "#3c3c3c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bB7",
      "roundness": null,
      "seed": 1687974568,
      "version": 93,
      "versionNonce": 616901800,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782859412142,
      "link": null,
      "locked": false,
      "text": "Memory loop (dashed line on the right): the surprise + a short story become the 'mood' note for the NEXT\nmeeting's Stage 1. Text only; the AI does not learn or change its settings.",
      "fontSize": 13,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Memory loop (dashed line on the right): the surprise + a short story become the 'mood' note for the NEXT\nmeeting's Stage 1. Text only; the AI does not learn or change its settings.",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "lb11q_0S02dPuU2r26uHI",
      "type": "text",
      "x": -2805.666666666667,
      "y": -1402.8333333333328,
      "width": 620.6841430664062,
      "height": 32.5,
      "angle": 0,
      "strokeColor": "#5f3dc4",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bB8",
      "roundness": null,
      "seed": 1623711144,
      "version": 93,
      "versionNonce": 1338595240,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782859412142,
      "link": null,
      "locked": false,
      "text": "Key idea: the Forecaster carries only the last guess forward, never re-reads old documents. The last guess\nis a complete stand-in for everything before it (a clean 'filtration').",
      "fontSize": 13,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Key idea: the Forecaster carries only the last guess forward, never re-reads old documents. The last guess\nis a complete stand-in for everything before it (a clean 'filtration').",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "UGoAB5y4B3LglDt2sF4or",
      "type": "text",
      "x": -2805.666666666667,
      "y": -1356.8333333333328,
      "width": 547.0263061523438,
      "height": 16.25,
      "angle": 0,
      "strokeColor": "#3c3c3c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bB9",
      "roundness": null,
      "seed": 978184360,
      "version": 93,
      "versionNonce": 2131763880,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782859412142,
      "link": null,
      "locked": false,
      "text": "The Beige Book step usually moves the guess the most: it is the freshest real-economy news.",
      "fontSize": 13,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The Beige Book step usually moves the guess the most: it is the freshest real-economy news.",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "1Ht2yNov5fmtewhbT9dFA",
      "type": "text",
      "x": -2805.666666666667,
      "y": -1324.8333333333328,
      "width": 628.5621337890625,
      "height": 32.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bBA",
      "roundness": null,
      "seed": 752522152,
      "version": 93,
      "versionNonce": 1363512744,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782859412142,
      "link": null,
      "locked": false,
      "text": "Why it matters for us: this word-only surprise tracked bond moves well even in the zero-rate years, when\nmarket-based gauges went flat. It is the 'what is priced / what is the surprise' piece our dollar model needs.",
      "fontSize": 13,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why it matters for us: this word-only surprise tracked bond moves well even in the zero-rate years, when\nmarket-based gauges went flat. It is the 'what is priced / what is the surprise' piece our dollar model needs.",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
