    },
    {
      "id": "lwtF_IGtlT5XB3j3SM44T",
      "type": "text",
      "x": -2808.666666666667,
      "y": -610.8333333333328,
      "width": 560.5982666015625,
      "height": 113.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bBj",
      "roundness": null,
      "seed": 542880936,
      "version": 252,
      "versionNonce": 80221864,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782859412142,
      "link": null,
      "locked": false,
      "text": "- Measures the thing that actually moves the dollar: the decision minus what was priced. [F][us]\n- Heavily validated: stable across reruns, and it reads rather than memorizes\n  (cross-model and look-ahead tests). [F]\n- Explains a large share of the decision from words alone, and keeps working through\n  the near-zero-rate years. [F]\n- Explainable end to end: a structured reading plus a written reason for each guess. [F][us]\n- Reusable for us: the document readers plus a running forecast are a clean template. [us]",
      "fontSize": 13,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Measures the thing that actually moves the dollar: the decision minus what was priced. [F][us]\n- Heavily validated: stable across reruns, and it reads rather than memorizes\n  (cross-model and look-ahead tests). [F]\n- Explains a large share of the decision from words alone, and keeps working through\n  the near-zero-rate years. [F]\n- Explainable end to end: a structured reading plus a written reason for each guess. [F][us]\n- Reusable for us: the document readers plus a running forecast are a clean template. [us]",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
