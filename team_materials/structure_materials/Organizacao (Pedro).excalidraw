    {
      "id": "oQ8q1f85d_s5khqyEOa9e",
      "type": "text",
      "x": -2624.666666666667,
      "y": -1560.3333333333328,
      "width": 458,
      "height": 65,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
