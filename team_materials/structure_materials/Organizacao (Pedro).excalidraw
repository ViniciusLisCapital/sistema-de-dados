      "link": null,
      "locked": false,
      "text": "2. Pros",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. Pros",
      "autoResize": true,
