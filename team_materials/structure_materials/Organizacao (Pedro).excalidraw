    },
    {
      "id": "F-fEf0cowh-nrPwrcsLHZ",
      "type": "text",
      "x": -2808.666666666667,
      "y": -433.0833333333328,
      "width": 513.9412841796875,
      "height": 146.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bBm",
      "roundness": null,
      "seed": 453580200,
      "version": 252,
      "versionNonce": 1994427560,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782859412142,
      "link": null,
      "locked": false,
      "text": "- It is all LLM judgment, no real math, so the 'as-if Bayesian' label oversells it:\n  the numbers are reasoned, not computed. [us]\n- The reading weights (especially inside the Beige Book) are re-decided by the AI each\n  meeting: flexible, but hard to audit and able to drift. [us]\n- One wrong reason can quietly contaminate the next meeting's first guess through the\n  memory note (a slow telephone effect), until fresh documents correct it. [us]\n- Coverage is uneven: press conferences only exist from 2011, and emergency meetings\n  have no Beige Book. [F][us]\n- It forecasts the rate decision, not the full market reaction. [us]",
      "fontSize": 13,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- It is all LLM judgment, no real math, so the 'as-if Bayesian' label oversells it:\n  the numbers are reasoned, not computed. [us]\n- The reading weights (especially inside the Beige Book) are re-decided by the AI each\n  meeting: flexible, but hard to audit and able to drift. [us]\n- One wrong reason can quietly contaminate the next meeting's first guess through the\n  memory note (a slow telephone effect), until fresh documents correct it. [us]\n- Coverage is uneven: press conferences only exist from 2011, and emergency meetings\n  have no Beige Book. [F][us]\n- It forecasts the rate decision, not the full market reaction. [us]",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
