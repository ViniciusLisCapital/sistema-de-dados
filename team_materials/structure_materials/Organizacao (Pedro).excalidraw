    },
    {
      "id": "APHoZsauijeSEKPXj_ivZ",
      "type": "text",
      "x": -3348.666666666667,
      "y": -868.8333333333328,
      "width": 461.3834228515625,
      "height": 227.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9q",
      "roundness": null,
      "seed": 1870491048,
      "version": 98,
      "versionNonce": 1535761832,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782859412140,
      "link": null,
      "locked": false,
      "text": "- The 'fair math' twin secretly starts from the AI's own opinions,\n  so the two are not truly separate. [us]\n- It keeps grabbing the middle, so talking barely moves the number;\n  the famous '5 bp effect' is partly rigged by design. [us]\n- The Fed only moves in 25 bp steps, but the whole talking effect is\n  ~5 bp, and never flips the real decision in any test shown. [us]\n- It was tuned to a meeting whose answer the authors already knew. [us]\n- The 'how sure' number is just the AI guessing about itself. [us]\n- The people are thin: a name plus 5 fields, told to write 200+ words\n  and to 'change its mind' on command. [us]\n- Under pressure the authors tilt the deck (dovish Chair, weaker Chair,\n  cheaper dovish dissent for the likeliest successor), so the drama is\n  steered, not discovered. [us]",
      "fontSize": 14,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- The 'fair math' twin secretly starts from the AI's own opinions,\n  so the two are not truly separate. [us]\n- It keeps grabbing the middle, so talking barely moves the number;\n  the famous '5 bp effect' is partly rigged by design. [us]\n- The Fed only moves in 25 bp steps, but the whole talking effect is\n  ~5 bp, and never flips the real decision in any test shown. [us]\n- It was tuned to a meeting whose answer the authors already knew. [us]\n- The 'how sure' number is just the AI guessing about itself. [us]\n- The people are thin: a name plus 5 fields, told to write 200+ words\n  and to 'change its mind' on command. [us]\n- Under pressure the authors tilt the deck (dovish Chair, weaker Chair,\n  cheaper dovish dissent for the likeliest successor), so the drama is\n  steered, not discovered. [us]",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
