    {
      "id": "coNJjmB1LDyECFRwDoz3b",
      "type": "text",
      "x": -2808.666666666667,
      "y": -222.8333333333328,
      "width": 514.63037109375,
      "height": 97.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bBp",
      "roundness": null,
      "seed": 348526248,
      "version": 297,
      "versionNonce": 2021800693,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782920310636,
      "link": null,
      "locked": false,
      "text": "- How big a nudge each reading produces is never a formula; it is the Forecaster's\n  judgment, so the same reading can move the guess differently run to run. [us]\n- How the AI picks the per-meeting district weights inside the Beige Book is described\n  in spirit, not as a fixed rule. [us]\n- The exact prompts, and how the between-meeting 'mood' note is summarized, are not\n  fully pinned down. [us]",
      "fontSize": 13,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- How big a nudge each reading produces is never a formula; it is the Forecaster's\n  judgment, so the same reading can move the guess differently run to run. [us]\n- How the AI picks the per-meeting district weights inside the Beige Book is described\n  in spirit, not as a fixed rule. [us]\n- The exact prompts, and how the between-meeting 'mood' note is summarized, are not\n  fully pinned down. [us]",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
