    },
    {
      "id": "y9HVcqF3w4XL0DqStCZ3c",
      "type": "text",
      "x": -3718.666666666667,
      "y": -960.8333333333328,
      "width": 254.29261779785156,
      "height": 130,
      "angle": 0,
      "strokeColor": "#3c3c3c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b8R",
      "roundness": null,
      "seed": 1529753768,
      "version": 93,
      "versionNonce": 2146080680,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782859412138,
      "link": null,
      "locked": false,
      "text": "- Explainable: every call has a written\n  reason (unlike black-box models).\n- Modular: swap models per task; add or\n  replace roles without a rewrite.\n- Structured board limits context loss.\n- Debate shows both sides; risk team\n  adds guardrails.\n- Strong reported backtest (return, Sharpe).",
      "fontSize": 13,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Explainable: every call has a written\n  reason (unlike black-box models).\n- Modular: swap models per task; add or\n  replace roles without a rewrite.\n- Structured board limits context loss.\n- Debate shows both sides; risk team\n  adds guardrails.\n- Strong reported backtest (return, Sharpe).",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
