      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "Zfxz3FqiezJ2dj7EUY7ov",
      "type": "text",
      "x": -3348.666666666667,
      "y": -1008.8333333333328,
      "width": 448.65740966796875,
      "height": 87.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9n",
      "roundness": null,
      "seed": 1441860776,
      "version": 98,
      "versionNonce": 1742841768,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782859412140,
      "link": null,
      "locked": false,
      "text": "- Clean setup: same start, so any difference is the talking. [F]\n- Uses real data and real speeches; read the meeting's story. [F]\n- Flip switches (political pressure, bad jobs news) and watch. [F]\n- Reusable idea for us: one team makes facts, another forms views. [us]\n- It models real arguing (many talk to many), not one lecturer. [us]",
      "fontSize": 14,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Clean setup: same start, so any difference is the talking. [F]\n- Uses real data and real speeches; read the meeting's story. [F]\n- Flip switches (political pressure, bad jobs news) and watch. [F]\n- Reusable idea for us: one team makes facts, another forms views. [us]\n- It models real arguing (many talk to many), not one lecturer. [us]",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
