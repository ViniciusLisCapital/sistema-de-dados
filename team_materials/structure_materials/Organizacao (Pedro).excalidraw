    },
    {
      "id": "MazkxAJ-gEb5UJCIoztkB",
      "type": "text",
      "x": -4098.666666666667,
      "y": -508.8333333333328,
      "width": 106.59983825683594,
      "height": 16.25,
      "angle": 0,
      "strokeColor": "#2b8a3e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b8b",
      "roundness": null,
      "seed": 1073282728,
      "version": 94,
      "versionNonce": 1921956264,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782859412138,
      "link": null,
      "locked": false,
      "text": "Defends against it",
      "fontSize": 13,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Defends against it",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "J_p-_EvAPfB7CndOTQG40",
      "type": "text",
      "x": -4098.666666666667,
      "y": -490.8333333333328,
      "width": 549.2882080078125,
      "height": 32.5,
      "angle": 0,
      "strokeColor": "#3c3c3c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b8c",
      "roundness": null,
      "seed": 951249320,
      "version": 94,
      "versionNonce": 651773096,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782859412138,
      "link": null,
      "locked": false,
      "text": "Agents pass finished structured reports, not a growing chat log. A facilitator compresses each\ndebate into one entry before it moves on, so free dialogue never enters the long chain.",
      "fontSize": 13,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Agents pass finished structured reports, not a growing chat log. A facilitator compresses each\ndebate into one entry before it moves on, so free dialogue never enters the long chain.",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "Nk0GnuMCQlBdc1BJBtXqf",
      "type": "text",
      "x": -4098.666666666667,
      "y": -444.8333333333328,
      "width": 92.74188232421875,
      "height": 16.25,
      "angle": 0,
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b8d",
      "roundness": null,
      "seed": 2029483176,
      "version": 94,
      "versionNonce": 664432552,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782859412138,
      "link": null,
      "locked": false,
      "text": "But does not fix",
      "fontSize": 13,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "But does not fix",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "YcYywuPp7iYNu1skvkjF2",
      "type": "text",
      "x": -4098.666666666667,
      "y": -426.8333333333328,
      "width": 567.3712768554688,
      "height": 48.75,
      "angle": 0,
      "strokeColor": "#3c3c3c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b8e",
      "roundness": null,
      "seed": 1987223464,
      "version": 94,
      "versionNonce": 1828600488,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782859412138,
      "link": null,
      "locked": false,
      "text": "Each stage inherits a compressed verdict, not the evidence. Risk and the Fund Manager judge the\nTrader's conclusion, not the raw reports, so a tidy summary can be tidily wrong. The loss shifts\nfrom corruption (classic telephone) to omission: a dropped point is never recovered.",
      "fontSize": 13,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Each stage inherits a compressed verdict, not the evidence. Risk and the Fund Manager judge the\nTrader's conclusion, not the raw reports, so a tidy summary can be tidily wrong. The loss shifts\nfrom corruption (classic telephone) to omission: a dropped point is never recovered.",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "pyTYbK46HYgbvo5brO1uV",
