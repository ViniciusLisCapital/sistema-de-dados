# Temporary editor/tool files
*.tmp
*.tmp.*

# Session handover notes (ephemeral, regenerated by the /handover skill).
# O glob cobre os sufixados (HANDOVER_credit.md etc.) -- a regra antiga era
# `/HANDOVER.md` exato, e tres deles acabaram versionados por causa disso.
/HANDOVER*.md

# Dropbox metadata
.dropbox
.dropbox.cache/
~$*

# OS
.DS_Store
Thumbs.db
desktop.ini

# Pesos/checkpoints do teste LSTM (binarios grandes; os CSV de previsao ficam versionados)
analytics/brasil/monetary_policy/teste_lstm/data/*.pt
analytics/brasil/monetary_policy/teste_lstm/data/*.pth
analytics/brasil/monetary_policy/teste_lstm/data/checkpoints/

# Cache do TaxaSwap da B3 (~5.100 CSV por pregao, reproduzivel da fonte)
domain/db/brasil/b3/cache/

# Logs da tarefa agendada (atualizar_diario.bat, um por dia, poda em 30 dias)
logs/
